+/* Count only handled virtual-timer IRQs and SGI1, without console I/O in IRQs. */
+static uint64_t sweet_timer_irqs[MAX_CPUS];
+static uint64_t sweet_sgi1_irqs[MAX_CPUS];
+void sweet_cpu_note_irq(unsigned int cpu, unsigned int timer);
+uint64_t sweet_cpu_irq_count(unsigned int cpu, unsigned int timer);
+
+void
+sweet_cpu_note_irq(unsigned int cpu, unsigned int timer)
+{
+	if (cpu < MAX_CPUS) {
+		uint64_t *counter = timer ? &sweet_timer_irqs[cpu] : &sweet_sgi1_irqs[cpu];
+		(void)__atomic_fetch_add(counter, 1, __ATOMIC_RELAXED);
+	}
+}
+
+uint64_t
+sweet_cpu_irq_count(unsigned int cpu, unsigned int timer)
+{
+	if (cpu >= MAX_CPUS) {
+		return 0;
+	}
+	uint64_t *counter = timer ? &sweet_timer_irqs[cpu] : &sweet_sgi1_irqs[cpu];
+	return __atomic_load_n(counter, __ATOMIC_ACQUIRE);
+}
