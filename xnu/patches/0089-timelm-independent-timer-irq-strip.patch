+
+/* 0089: only CPU0 timer IRQ writes this strip. No printf, locks or allocation. */
+static unsigned int timelm_irq_strip;
+static inline unsigned long long
+ timelm_irq_get(unsigned int slot)
+{
+    return __atomic_load_n(&timelm_irq_values[slot], __ATOMIC_RELAXED);
+}
+static inline void
+ timelm_irq_set(unsigned int slot, unsigned long long value)
+{
+    __atomic_store_n(&timelm_irq_values[slot], value, __ATOMIC_RELAXED);
+}
+static char *
+ timelm_irq_number(char *p, unsigned long long value, unsigned int base)
+{
+    char digits[20];
+    unsigned int n = 0;
+    do {
+        unsigned int digit = (unsigned int)(value % base);
+        digits[n++] = "0123456789abcdef"[digit];
+        value /= base;
+    } while (value && n < sizeof(digits));
+    while (n) { *p++ = digits[--n]; }
+    return p;
+}
+static void
+ timelm_irq_draw(void)
+{
+    uintptr_t pixels = __atomic_load_n(&timelm_diag_pixels, __ATOMIC_ACQUIRE);
+    if (pixels == 0 || !timelm_irq_strip) { return; }
+    /* Worst case 3x20 decimal + 16 hex + 22 literal bytes fits this buffer. */
+    char text[128], *p = text;
+    const char *label = "I89 I=";
+    while (*label) { *p++ = *label++; }
+    p = timelm_irq_number(p, timelm_irq_get(TIMELM_I_ENTER), 10);
+    *p++ = ' '; *p++ = 'O'; *p++ = '=';
+    p = timelm_irq_number(p, timelm_irq_get(TIMELM_I_DONE), 10);
+    *p++ = ' '; *p++ = 'H'; *p++ = '=';
+    p = timelm_irq_number(p, timelm_diag_get(TIMELM_D_HEARTBEAT), 10);
+    *p++ = ' '; *p++ = 'P'; *p++ = 'C'; *p++ = '=';
+    p = timelm_irq_number(p, timelm_irq_get(TIMELM_I_PC), 16);
+    *p++ = ' ';
+    *p++ = (timelm_irq_get(TIMELM_I_PSR) & 0xf) == 0 ? 'U' : 'K';
+    *p++ = ' '; *p++ = 'F'; *p++ = '=';
+    *p++ = '0' + (char)timelm_irq_get(TIMELM_I_PHASE);
+    *p = 0;
+    uint32_t width = timelm_diag_width, stride = timelm_diag_stride;
+    uint32_t top = timelm_diag_height - TIMELM_DIAG_ROWS - TIMELM_IRQ_ROWS;
+    for (uint32_t gy = 0; gy < TIMELM_IRQ_ROWS; gy++) {
+        volatile uint32_t *row = (volatile uint32_t *)(pixels + (uint64_t)(top + gy) * stride);
+        for (uint32_t x = 0; x < width; x++) {
+            unsigned int col = x / 16, bit = (x % 16) / 2;
+            unsigned char ch = col < (unsigned int)(p - text) ? (unsigned char)text[col] : ' ';
+            row[x] = (iso_font[(unsigned int)ch * 16 + gy / 2] & (1u << bit)) ? 0xffffffff : 0xff000000;
+        }
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+extern "C" unsigned int
+ timelm_irq_enter(unsigned long long pc, unsigned long long psr)
+{
+    if (!__atomic_load_n(&timelm_irq_enabled, __ATOMIC_ACQUIRE)) { return 0; }
+    unsigned long long now = mach_absolute_time();
+    (void)__atomic_fetch_add(&timelm_irq_values[TIMELM_I_ENTER], 1, __ATOMIC_RELAXED);
+    timelm_irq_set(TIMELM_I_ENTER_ABS, now);
+    timelm_irq_set(TIMELM_I_PC, pc);
+    timelm_irq_set(TIMELM_I_PSR, psr);
+    timelm_irq_set(TIMELM_I_PHASE, 1);
+    if (now - timelm_irq_get(TIMELM_I_DRAW_ABS) >= timelm_irq_period &&
+        __atomic_load_n(&timelm_diag_pixels, __ATOMIC_ACQUIRE) && timelm_irq_strip) {
+        timelm_irq_set(TIMELM_I_DRAW_ABS, now);
+        timelm_irq_draw();
+        return 1;
+    }
+    return 0;
+}
+extern "C" void
+ timelm_irq_done(unsigned int redraw)
+{
+    if (!__atomic_load_n(&timelm_irq_enabled, __ATOMIC_ACQUIRE)) { return; }
+    (void)__atomic_fetch_add(&timelm_irq_values[TIMELM_I_DONE], 1, __ATOMIC_RELAXED);
+    timelm_irq_set(TIMELM_I_DONE_ABS, mach_absolute_time());
+    timelm_irq_set(TIMELM_I_PHASE, 2);
+    if (redraw) { timelm_irq_draw(); }
+}
