+/*
+ * A heartbeat line every "sweetbeat" seconds (boot-arg, default 0 = off).
+ * The console is only readable from the phone screen, so this is what tells
+ * "the kernel hung here" apart from "the console stopped working".
+ */
+void sweet_heartbeat_start(void);
+
+static int sweet_heartbeat_chan;
+static uint32_t sweet_heartbeat_secs;
+
+static void __attribute__((noreturn))
+sweet_heartbeat_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t n = 0;
+
+	for (;;) {
+		(void)tsleep(&sweet_heartbeat_chan, PZERO, "sweet-hb", hz * (int)sweet_heartbeat_secs);
+		printf("SWEET: heartbeat %u\n", ++n);
+	}
+}
+
+void
+sweet_heartbeat_start(void)
+{
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetbeat", &sweet_heartbeat_secs, sizeof(sweet_heartbeat_secs));
+	if (sweet_heartbeat_secs == 0 || sweet_heartbeat_secs > 3600) {
+		return;
+	}
+	if (kernel_thread_start(sweet_heartbeat_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
