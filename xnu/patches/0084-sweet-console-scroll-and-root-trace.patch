+/*
+ * Move the text area up by one row and clear the last row: the screen then
+ * shows the most recent lines in the order they were printed.
+ */
+static void
+fbcon_scroll(void)
+{
+	uint32_t row_words = (fbcon_stride / 4) * (16 * FBCON_SCALE);
+	volatile uint32_t *dst = fbcon_base;
+	volatile uint32_t *src = fbcon_base + row_words;
+
+	for (uint32_t i = 0; i < row_words * (fbcon_rows - 1); i++) {
+		dst[i] = src[i];
+	}
+	fbcon_clear_row(fbcon_rows - 1);
+}
+
 static void
 fbcon_newline(void)
 {
 	fbcon_col = 0;
-	fbcon_row = (fbcon_row + 1) % fbcon_rows;
-	fbcon_clear_row(fbcon_row);
-	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+	if (fbcon_row + 1 >= fbcon_rows) {
+		fbcon_scroll();
+		fbcon_row = fbcon_rows - 1;
+	} else {
+		fbcon_row++;
+		fbcon_clear_row(fbcon_row);
+	}
 }
 
