+/* Published once after framebuffer setup; observer uses no IOKit/console locks. */
+extern "C" unsigned char iso_font[];
+static uintptr_t timelm_diag_pixels;
+static uint32_t timelm_diag_width, timelm_diag_height, timelm_diag_stride;
+
+extern "C" void
+timelm_diag_draw(void)
+{
+    uintptr_t pixels = __atomic_load_n(&timelm_diag_pixels, __ATOMIC_ACQUIRE);
+    if (pixels == 0 || !timelm_diag_enabled) {
+        return;
+    }
+    uint32_t width = timelm_diag_width, height = timelm_diag_height;
+    uint32_t stride = timelm_diag_stride;
+    char text[2][128];
+    snprintf(text[0], sizeof(text[0]), "D88 HB=%llu T=%llu S=%llu P=%llu C=%llu R=%llu",
+        timelm_diag_get(TIMELM_D_HEARTBEAT), timelm_diag_get(TIMELM_D_TIMER),
+        timelm_diag_get(TIMELM_D_SUBMITTED), timelm_diag_get(TIMELM_D_PRESENTED),
+        timelm_diag_get(TIMELM_D_COPIED), timelm_diag_get(TIMELM_D_REJECTED));
+    snprintf(text[1], sizeof(text[1]), "L=%llu F=%llu W=%llu U=%llu/%llu:%llu OP=%02llx E=%llu",
+        timelm_diag_get(TIMELM_D_LOG_SEQ), timelm_diag_get(TIMELM_D_LOG_PHASE),
+        timelm_diag_get(TIMELM_D_UFS_WAITERS), timelm_diag_get(TIMELM_D_UFS_DONE),
+        timelm_diag_get(TIMELM_D_UFS_COMMANDS), timelm_diag_get(TIMELM_D_UFS_PHASE),
+        timelm_diag_get(TIMELM_D_UFS_OPCODE), timelm_diag_get(TIMELM_D_LAST_ERRNO));
+    for (uint32_t y = height - TIMELM_DIAG_ROWS; y < height; y++) {
+        volatile uint32_t *row = (volatile uint32_t *)(pixels + (uint64_t)y * stride);
+        for (uint32_t x = 0; x < width; x++) {
+            row[x] = 0xff000000;
+        }
+    }
+    for (unsigned int line = 0; line < 2; line++) {
+        for (unsigned int col = 0; text[line][col] && col < width / 16; col++) {
+            unsigned char ch = (unsigned char)text[line][col];
+            for (unsigned int gy = 0; gy < 16; gy++) {
+                for (unsigned int gx = 0; gx < 8; gx++) {
+                    if (!(iso_font[(unsigned int)ch * 16 + gy] & (1u << gx))) {
+                        continue;
+                    }
+                    for (unsigned int sy = 0; sy < 2; sy++) {
+                        uint32_t y = height - TIMELM_DIAG_ROWS + line * 32 + gy * 2 + sy;
+                        volatile uint32_t *row = (volatile uint32_t *)(pixels + (uint64_t)y * stride);
+                        row[col * 16 + gx * 2] = 0xffffffff;
+                        row[col * 16 + gx * 2 + 1] = 0xffffffff;
+                    }
+                }
+            }
+        }
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+}
