+/* 0090: no formatter, no context-pointer dereference, no console/UFS/locks. */
+static void
+ timelm90_line(const char *text, unsigned int line)
+{
+    uintptr_t pixels = __atomic_load_n(&timelm_diag_pixels, __ATOMIC_ACQUIRE);
+    if (!pixels || !timelm_irq_strip || line >= 3) { return; }
+    uint32_t top = timelm_diag_height - TIMELM_DIAG_ROWS - TIMELM_IRQ_ROWS + line * 32;
+    unsigned int len = 0;
+    while (len < 127 && text[len]) { len++; }
+    for (uint32_t gy = 0; gy < 32; gy++) {
+        volatile uint32_t *row = (volatile uint32_t *)(pixels + (uint64_t)(top + gy) * timelm_diag_stride);
+        for (uint32_t x = 0; x < timelm_diag_width; x++) {
+            unsigned int col = x / 16, bit = (x % 16) / 2;
+            unsigned char ch = col < len ? (unsigned char)text[col] : ' ';
+            row[x] = iso_font[(unsigned int)ch * 16 + gy / 2] & (1u << bit) ? 0xffffffff : 0xff600000;
+        }
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+static char *
+ timelm90_label(char *p, const char *label, unsigned long long value)
+{
+    while (*label) { *p++ = *label++; }
+    return timelm_irq_number(p, value, 16);
+}
+extern "C" void
+ timelm90_panic(unsigned long long kind, unsigned long long caller,
+    unsigned long long pc, unsigned long long lr, unsigned long long esr,
+    unsigned long long far, unsigned long long format)
+{
+    if (!__atomic_load_n(&timelm_diag_enabled, __ATOMIC_ACQUIRE)) { return; }
+    (void)__atomic_fetch_add(&timelm90_values[TIMELM90_EVENTS], 1, __ATOMIC_RELAXED);
+    if (__atomic_exchange_n(&timelm90_claimed, 1, __ATOMIC_ACQ_REL)) { return; }
+    __atomic_store_n(&timelm90_values[TIMELM90_CALLER], caller, __ATOMIC_RELAXED);
+    __atomic_store_n(&timelm90_values[TIMELM90_PC], pc, __ATOMIC_RELAXED);
+    __atomic_store_n(&timelm90_values[TIMELM90_LR], lr, __ATOMIC_RELAXED);
+    __atomic_store_n(&timelm90_values[TIMELM90_ESR], esr, __ATOMIC_RELAXED);
+    __atomic_store_n(&timelm90_values[TIMELM90_FAR], far, __ATOMIC_RELAXED);
+    __atomic_store_n(&timelm90_values[TIMELM90_FORMAT], format, __ATOMIC_RELAXED);
+    __atomic_store_n(&timelm90_values[TIMELM90_EVENT], kind, __ATOMIC_RELEASE);
+    if (!timelm_status_draw || !timelm_irq_strip ||
+        !__atomic_load_n(&timelm_diag_pixels, __ATOMIC_ACQUIRE)) { return; }
+    __atomic_store_n(&timelm90_values[TIMELM90_PANIC_DRAW], 1, __ATOMIC_RELAXED);
+    char text[128], *p;
+    p = timelm90_label(text, "P90 EVENT=", kind);
+    p = timelm90_label(p, " CALL=", caller);
+    p = timelm90_label(p, " PC=", pc); *p = 0; timelm90_line(text, 0);
+    p = timelm90_label(text, "ESR=", esr);
+    p = timelm90_label(p, " FAR=", far);
+    p = timelm90_label(p, " LR=", lr); *p = 0; timelm90_line(text, 1);
+    p = timelm90_label(text, "FMT@", format);
+    p = timelm90_label(p, " IRQ-Q=", __atomic_load_n(&timelm90_values[TIMELM90_IRQ_STAGE], __ATOMIC_RELAXED));
+    *p = 0; timelm90_line(text, 2);
+    __atomic_store_n(&timelm90_values[TIMELM90_PANIC_DRAW], 2, __ATOMIC_RELAXED);
+}
+extern "C" void
+ timelm90_stage(unsigned int stage, unsigned int redraw)
+{
+    if (!__atomic_load_n(&timelm_irq_enabled, __ATOMIC_ACQUIRE)) { return; }
+    __atomic_store_n(&timelm90_values[TIMELM90_IRQ_STAGE], stage, __ATOMIC_RELAXED);
+    if (stage == 6) {
+        (void)__atomic_fetch_add(&timelm90_values[TIMELM90_IRQ_FULL], 1, __ATOMIC_RELAXED);
+    }
+    uintptr_t pixels = __atomic_load_n(&timelm_diag_pixels, __ATOMIC_ACQUIRE);
+    if (!redraw || !timelm_status_draw || __atomic_load_n(&timelm90_claimed, __ATOMIC_ACQUIRE) || !pixels ||
+        !timelm_irq_strip || timelm_diag_width < 32 || stage > 9) { return; }
+    uint32_t top = timelm_diag_height - TIMELM_DIAG_ROWS - TIMELM_IRQ_ROWS;
+    for (uint32_t gy = 0; gy < 32; gy++) {
+        volatile uint32_t *row = (volatile uint32_t *)(pixels + (uint64_t)(top + gy) * timelm_diag_stride);
+        for (uint32_t x = 0; x < 32; x++) {
+            unsigned int ch = x < 16 ? 'Q' : '0' + stage;
+            row[timelm_diag_width - 32 + x] = iso_font[ch * 16 + gy / 2] & (1u << ((x % 16) / 2)) ? 0xff00ff00 : 0xff000000;
+        }
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+extern "C" void
+ timelm90_timer(unsigned long long ctl, unsigned long long cval)
+{
+    if (!__atomic_load_n(&timelm_irq_enabled, __ATOMIC_ACQUIRE)) { return; }
+    __atomic_store_n(&timelm90_values[TIMELM90_TIMER_CTL], ctl, __ATOMIC_RELAXED);
+    __atomic_store_n(&timelm90_values[TIMELM90_TIMER_CVAL], cval, __ATOMIC_RELAXED);
 }
 
