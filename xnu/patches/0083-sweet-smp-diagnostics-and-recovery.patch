diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..2d1ea62 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -176,6 +176,21 @@ pe_init_fiq()
 		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
 	}
 	gicr_write32(GICR_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+	/*
+	 * The CPU interface of a redistributor belongs to a single PE. The
+	 * bootloader only enables the one of the boot CPU, so without this a
+	 * secondary PE never receives its timer or the SGIs that XNU uses for
+	 * IPIs. GICR_CTLR is a secure register on a GIC with security
+	 * extensions, so the write can be ignored: report what the hardware
+	 * says instead of assuming it worked.
+	 */
+	uint32_t gicr_ctlr = gicr_read32(GICR_CTLR);
+	gicr_write32(GICR_CTLR, gicr_ctlr | GICR_CTLR_ENABLEGRP1NS);
+	uint32_t gicr_ctlr_now = gicr_read32(GICR_CTLR);
+	kprintf("SWEET GIC: PE 0x%llx typer=0x%llx ctlr=0x%x->0x%x waker=0x%x igroupr=0x%x isenabler=0x%x gicd=0x%x\n",
+	    (uint64_t)gicr_pe_base, gicr_read64(GICR_TYPER), gicr_ctlr, gicr_ctlr_now,
+	    gicr_read32(GICR_WAKER), gicr_read32(GICR_IGROUPR0),
+	    gicr_read32(GICR_ISENABLER0), gicd_read32(GICD_CTLR));
 #else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
