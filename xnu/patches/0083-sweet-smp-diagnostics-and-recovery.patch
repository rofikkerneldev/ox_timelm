--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -975,6 +975,21 @@ sweet_cpu_signal_is_enabled(unsigned int cpu)
 	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
 	return cdp != NULL && !(os_atomic_load(&cdp->cpu_signal, acquire) & SIGPdisabled);
 }
+
+/* Bring-up observer: the raw signal mask of a CPU, for diagnostics. */
+uint32_t sweet_cpu_signal_state(unsigned int cpu);
+uint32_t
+sweet_cpu_signal_state(unsigned int cpu)
+{
+	if (cpu >= MAX_CPUS) {
+		return 0;
+	}
+	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
+	if (cdp == NULL) {
+		return 0;
+	}
+	return os_atomic_load(&cdp->cpu_signal, acquire);
+}
 #endif
 
 
