 extern "C" void sweet_secondary_entry(void);
 extern "C" boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+extern "C" uint32_t sweet_cpu_signal_state(unsigned int cpu);
+
+/*
+ * Bring-up handshake between the boot CPU and a secondary.
+ *
+ * XNU does not assume that the CPUs of this platform snoop each other's
+ * caches, so a flag written by a secondary only reaches the boot CPU after
+ * an explicit clean. Every CPU owns one aligned cache line so that the flag
+ * never shares a line with data that is written concurrently.
+ *
+ * Stage 0: nothing seen, 1: the secondary entered initCPU(), 2: the
+ * secondary finished initCPU() and runs.
+ */
+#define SWEET_CPU_STAGE_NONE    0
+#define SWEET_CPU_STAGE_INIT    1
+#define SWEET_CPU_STAGE_READY   2
+
+static volatile uint32_t sweet_cpu_stage[MAX_CPUS] __attribute__((aligned(64)));
+
+/* Kryo 470 uses 64 byte cache lines. */
+#define SWEET_CACHE_LINE        64
+
+static inline void
+sweet_cpu_clean_line(vm_offset_t addr)
+{
+	vm_offset_t p = addr & ~(vm_offset_t)(SWEET_CACHE_LINE - 1);
+
+	/* Clean the line to the point of coherency so other CPUs see it. */
+	__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+	__builtin_arm_dsb(DSB_ISHST);
+}
+
+static inline void
+sweet_cpu_invalidate_line(vm_offset_t addr)
+{
+	vm_offset_t p = addr & ~(vm_offset_t)(SWEET_CACHE_LINE - 1);
+
+	/* Drop a stale copy of the line before reading it again. */
+	__asm__ volatile("dc ivac, %0" :: "r"(p) : "memory");
+	__builtin_arm_dsb(DSB_ISHST);
+}
+
+static inline void
+sweet_cpu_publish_stage(unsigned int cpu, uint32_t stage)
+{
+	sweet_cpu_stage[cpu] = stage;
+	sweet_cpu_clean_line((vm_offset_t)&sweet_cpu_stage[cpu]);
+}
+
+static inline uint32_t
+sweet_cpu_read_stage(unsigned int cpu)
+{
+	sweet_cpu_invalidate_line((vm_offset_t)&sweet_cpu_stage[cpu]);
+	return sweet_cpu_stage[cpu];
+}
 
 class SweetCPU;
 static SweetCPU *sweet_cpus[MAX_CPUS];
