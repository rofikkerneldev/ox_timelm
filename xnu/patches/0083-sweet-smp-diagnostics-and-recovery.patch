 	if (aff0 >= 16) {
 		panic("SWEET CPU: SGI target requires unsupported range selector");
 	}
-	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
-	    (((mpidr >> 16) & 0xff) << 32) |
-	    (((mpidr >> 8) & 0xff) << 16) |
-	    ((uint64_t)SWEET_IPI_SGI << 24) | (1ULL << aff0);
+	/*
+	 * GICv3 "Interrupt Routing Register" (ICC_SGI1R_EL1):
+	 *   [3:0]   target list (the Aff0 of the target PE)
+	 *   [10:4]  INTID
+	 *   [23:16] Aff1
+	 *   [31:24] Aff2
+	 *   [63:32] Aff3
+	 * The previous encoding put the INTID into the Aff2 field and the
+	 * Aff1 of the target into the Aff3 field: every SGI was dropped.
+	 */
+	uint64_t sgi = (((mpidr >> 32) & 0xffULL) << 32) |	/* Aff3 */
+	    (((mpidr >> 16) & 0xffULL) << 24) |		/* Aff2 */
+	    (((mpidr >> 8) & 0xffULL) << 16) |		/* Aff1 */
+	    ((uint64_t)SWEET_IPI_SGI << 4) |		/* INTID */
+	    (1ULL << aff0);				/* target list */
+	if (target == this) {
+		kprintf("SWEET CPU: cpu=%u self-SGI%d mpidr=0x%llx value=0x%llx\n",
+		    logical, SWEET_IPI_SGI, mpidr, sgi);
+	}
 	__builtin_arm_dsb(DSB_ISHST);
 	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
 	__builtin_arm_isb(ISB_SY);
