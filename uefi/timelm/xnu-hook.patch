+STATIC VOID TimelmTryXnuPayload (VOID)
+{
+  CONST unsigned char *Image;
+  unsigned int Length;
+  EFI_HANDLE Handle;
+  if (!TimelmFindLoader ((CONST unsigned char *)(UINTN)0xF0000000,
+                        0x04000000, &Image, &Length)) return;
+  EFI_STATUS Status = gBS->LoadImage (FALSE, gImageHandle, NULL,
+                                     (VOID *)Image, Length, &Handle);
+  if (!EFI_ERROR (Status)) gBS->StartImage (Handle, NULL, NULL);
+}
