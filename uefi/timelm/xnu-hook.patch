+  ldp   x2, x3, [x4], #16
+  stp   x2, x3, [x5], #16
+  subs  x6, x6, #16
+  b.ne  _CopyXnuPayload
+_NoXnuPayload:
+#endif
   ldr   x5, =FD_BASE
 
