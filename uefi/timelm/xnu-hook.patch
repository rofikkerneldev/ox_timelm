   b.ne  _CopyLoop
+#ifdef PAYLOAD_BASE
+  ldr   w2, [x4]
+  movz  w3, #0x4E58
+  movk  w3, #0x5055, lsl #16
+  cmp   w2, w3
+  b.ne  _NoXnuPayload
+  ldr   w6, [x4, #4]
+  add   x6, x6, #23
+  and   x6, x6, #~15
+  mov   x7, #0x04000000
